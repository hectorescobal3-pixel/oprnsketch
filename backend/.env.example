# ==============================================================================
# opensketch Backend Configuration Template (.env.example)
# ESCORP IDS - Environment Variables Definition
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ALLOWED_ORIGIN=http://localhost:3000

# Session & Security (Required in NODE_ENV=production)
# Generate with: openssl rand -hex 32
SESSION_SECRET=your_secure_random_session_secret_32_bytes_min
SESSION_MAX_AGE_SECONDS=604800

# Database Configuration (PostgreSQL 16 with Row-Level Security)
DATABASE_URL=postgresql://postgres:postgres_password@localhost:5432/opensketch_db
DB_POOL_MIN=2
DB_POOL_MAX=20

# Cache & Distributed Rate Limiter (Redis 7 - Optional in dev; uses resilient in-memory fallback when unset)
REDIS_URL=redis://localhost:6379

# Google Cloud & Vertex AI Integration
GOOGLE_CLOUD_PROJECT_ID=opensketch-production
GOOGLE_CLOUD_REGION=southamerica-east1
GOOGLE_CLOUD_STORAGE_BUCKET=opensketch-sales-documents

# Google OAuth 2.0 (OIDC Web Client)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# AI & Places Gateway Keys (Google Cloud APIs)
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Firebase / Cloud Run Production
FIREBASE_PROJECT_ID=opensketch-e7eb1
FRONTEND_URL=https://opensketch-e7eb1.web.app
APP_URL=https://opensketch-e7eb1.web.app

# PagBank Checkout & Webhook
PAGBANK_ENV=production
PAGBANK_TOKEN=
PAGBANK_WEBHOOK_SECRET=
PAGBANK_WEBHOOK_URL=

# SMTP / E-mail Transacional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=escorpsystems@gmail.com
SMTP_PASS=
SMTP_FROM="ESCORP I.D.S. <escorpsystems@gmail.com>"
